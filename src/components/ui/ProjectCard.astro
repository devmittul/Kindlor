---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  variant?: 'preview' | 'full';
  class?: string;
}

const {
  project,
  index = 0,
  variant = 'preview',
  class: className = '',
} = Astro.props;

const { data, slug } = project;
---

{variant === 'preview' ? (
  <article class={`bg-[var(--color-surface-card)] p-6 sm:p-8 rounded-xl border border-[var(--color-hairline)] flex flex-col justify-between group ${className}`}>
    <div class="space-y-4">
      <div class="flex items-center justify-between border-b border-[var(--color-hairline-strong)] pb-3">
        <h3 class="text-lg sm:text-xl font-sans font-bold text-[var(--color-ink)] tracking-tight">{data.title}</h3>
        <span class="text-[10px] uppercase text-[var(--color-muted)] font-mono">{data.industry}</span>
      </div>

      <!-- What was built -->
      <div>
        <p class="text-[14px] sm:text-[16px] text-[var(--color-body)] font-sans font-medium">{data.summary}</p>
      </div>

      <!-- Business Problem -->
      {data.challenge && (
        <div>
          <p class="text-[14px] sm:text-[16px] text-[var(--color-muted)] font-sans leading-relaxed">{data.challenge}</p>
        </div>
      )}

      <!-- Solution -->
      {data.solution && (
        <div>
          <p class="text-[14px] sm:text-[16px] text-[var(--color-muted)] font-sans leading-relaxed">{data.solution}</p>
        </div>
      )}

      <!-- Technologies -->
      <div>
        <span class="text-[10px] font-mono text-[var(--color-muted-soft)] uppercase tracking-wider block mb-1">TECHNOLOGIES</span>
        <div class="flex flex-wrap gap-1.5 pt-1">
          {data.technologies.map((tech) => (
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[var(--color-canvas)] text-[var(--color-muted)] border border-[var(--color-hairline)]">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Card Footer CTA -->
    <div class="mt-6 pt-4 border-t border-[var(--color-hairline-strong)] flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <span class="text-[10px] font-mono text-[var(--color-muted-soft)] uppercase">{data.year}</span>
        {data.website && (
          <a class="text-[14px] font-sans font-semibold text-[var(--color-primary)] hover:text-[var(--color-primary-active)] transition-colors flex items-center space-x-1.5" href={data.website} target="_blank" rel="noopener noreferrer">
            <span>LIVE SITE ↗</span>
          </a>
        )}
      </div>
      <a class="text-[14px] font-sans font-semibold text-[var(--color-primary)] hover:text-[var(--color-primary-active)] transition-colors flex items-center space-x-1.5" href={`/work/${slug}`}>
        <span>VIEW CASE STUDY</span>
        <span>→</span>
      </a>
    </div>
  </article>
) : (
  <article class={`bg-[var(--color-surface-card)] p-6 sm:p-10 rounded-xl border border-[var(--color-hairline)] space-y-6 group ${className}`}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[var(--color-hairline-strong)] pb-4 gap-2">
      <div class="flex items-center space-x-3">
        <span class="text-[12px] font-mono text-[var(--color-muted)] font-bold">PROJECT 0{index + 1}</span>
        <span class="text-[var(--color-hairline-strong)]">•</span>
        <span class="text-[12px] font-mono text-[var(--color-muted)] uppercase">{data.year}</span>
      </div>
      <span class="text-[12px] font-mono px-3 py-1 rounded-full bg-[var(--color-canvas)] text-[var(--color-muted)] border border-[var(--color-hairline)] w-max">
        {data.industry}
      </span>
    </div>

    <div class="space-y-2">
      <h2 class="text-2xl sm:text-4xl font-sans font-bold text-[var(--color-ink)] tracking-tight">
        {data.title}
      </h2>
      <p class="text-[14px] sm:text-[16px] text-[var(--color-body)] font-sans leading-relaxed">
        {data.summary}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-[var(--color-hairline-strong)] text-[14px]">
      <div class="space-y-1.5">
        <span class="font-mono text-[10px] text-[var(--color-muted-soft)] uppercase tracking-wider block">THE CHALLENGE</span>
        <p class="text-[var(--color-muted)] font-sans leading-relaxed">
          {data.challenge || 'Resolving direct online customer touchpoints and manual communication friction.'}
        </p>
      </div>

      <div class="space-y-1.5">
        <span class="font-mono text-[10px] text-[var(--color-muted-soft)] uppercase tracking-wider block">THE BUILD</span>
        <p class="text-[var(--color-muted)] font-sans leading-relaxed">
          {data.solution || data.description}
        </p>
      </div>

      <div class="space-y-1.5">
        <span class="font-mono text-[10px] text-[var(--color-muted-soft)] uppercase tracking-wider block">THE EXPERIENCE</span>
        <p class="text-[var(--color-muted)] font-sans leading-relaxed">
          {data.approach || 'Fast, responsive interface guiding visitors from initial discovery to instant action.'}
        </p>
      </div>

      <div class="space-y-1.5">
        <span class="font-mono text-[10px] text-[var(--color-muted-soft)] uppercase tracking-wider block">THE SYSTEM</span>
        <div class="flex flex-wrap gap-1.5 pt-1 font-mono text-[10px]">
          {data.technologies.map((tech) => (
            <span class="px-2 py-0.5 rounded-full bg-[var(--color-canvas)] text-[var(--color-muted)] border border-[var(--color-hairline)]">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="pt-4 border-t border-[var(--color-hairline-strong)] flex items-center justify-end space-x-4">
      {data.website && (
        <a class="px-5 py-3 border border-[var(--color-hairline-strong)] text-[var(--color-ink)] font-sans text-[14px] font-semibold rounded-md hover:border-[var(--color-ink)] transition-colors flex items-center space-x-2" href={data.website} target="_blank" rel="noopener noreferrer">
          <span>LIVE SITE ↗</span>
        </a>
      )}
      <a class="px-5 py-3 bg-[var(--color-primary)] text-[var(--color-on-primary)] font-sans text-[14px] font-semibold rounded-md hover:bg-[var(--color-primary-active)] transition-colors flex items-center space-x-2" href={`/work/${slug}`}>
        <span>VIEW PROJECT</span>
        <span>→</span>
      </a>
    </div>
  </article>
)}
