---
import type { Founder } from '../../data/foundersData';

interface Props {
  founder: Founder;
  class?: string;
}

const { founder, class: className = '' } = Astro.props;
---

<article class={`group relative bg-[var(--color-surface-card)] rounded-2xl overflow-hidden border border-[var(--color-hairline)] transition-all duration-500 hover:border-[var(--color-primary)] ${className}`}>
  <!-- Glow effect behind -->
  <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
  
  <div class="relative z-10 flex flex-col h-full">
    <!-- Image Header -->
    <div class="relative h-64 sm:h-80 overflow-hidden border-b border-[var(--color-hairline-strong)]">
      <img src={founder.image} alt={founder.name} class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-700 scale-100 group-hover:scale-105" />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-surface-card)] via-[var(--color-surface-card)]/20 to-transparent opacity-90"></div>
      
      <!-- Portfolio Link Overlay -->
      <div class="absolute top-4 right-4 translate-x-4 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-500 delay-100">
        <a href={founder.portfolioUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-12 h-12 bg-[var(--color-primary)] text-[var(--color-on-primary)] rounded-full hover:scale-110 hover:shadow-[0_0_20px_var(--color-primary)] transition-all shadow-lg" title="View Portfolio">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      </div>

      <div class="absolute bottom-4 left-6">
        <span class="inline-block px-3 py-1 bg-[var(--color-canvas)]/80 backdrop-blur-md text-[10px] font-mono text-[var(--color-primary)] font-bold uppercase tracking-wider rounded-full border border-[var(--color-hairline)]">
          {founder.role}
        </span>
      </div>
    </div>
    
    <!-- Content Area -->
    <div class="p-6 sm:p-8 space-y-6 flex-1 flex flex-col bg-[var(--color-surface-card)]">
      <div class="space-y-2">
        <h2 class="text-3xl font-sans font-black uppercase text-[var(--color-ink)] tracking-tight">
          {founder.name}
        </h2>
        <p class="text-[15px] text-[var(--color-body)] font-sans leading-relaxed flex-1">
          {founder.bio}
        </p>
      </div>
      
      <div class="space-y-3 pt-5 border-t border-[var(--color-hairline-strong)]">
        <span class="text-[10px] font-mono text-[var(--color-muted-soft)] uppercase tracking-wider block">{founder.focusTitle}</span>
        <ul class="flex flex-wrap gap-2 text-[11px] font-mono text-[var(--color-muted)]">
          {founder.focus.map((item) => (
            <li class="px-3 py-1.5 rounded bg-[var(--color-canvas)] border border-[var(--color-hairline)] group-hover:border-[var(--color-primary)]/40 transition-colors">{item}</li>
          ))}
        </ul>
      </div>

      <div class="pt-5 border-t border-[var(--color-hairline-strong)] mt-auto">
        <a href={founder.portfolioUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center space-x-2 text-[13px] font-sans font-bold text-[var(--color-primary)] hover:text-[var(--color-primary-active)] transition-colors">
          <span>VIEW PORTFOLIO</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</article>
