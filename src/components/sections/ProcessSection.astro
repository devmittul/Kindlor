---
import SectionHeader from '../ui/SectionHeader.astro';
import { PROCESS_STEPS } from '../../lib/constants';
---

<section class="py-16 sm:py-24 px-4 sm:px-12 lg:px-24 border-b border-[var(--color-hairline)]" id="process">
  <div class="max-w-6xl mx-auto space-y-10 sm:space-y-14">
    <SectionHeader
      number="03"
      eyebrow="OUR PROCESS"
      title="HOW WE BUILD YOUR DIGITAL SYSTEM."
    />

    <!-- 6 Step Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {PROCESS_STEPS.map((step) => (
        <div class="bg-[var(--color-surface-card)] p-6 rounded-xl border border-[var(--color-hairline)]  hover:border-[var(--color-hairline-strong)] transition-all space-y-3">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-[var(--color-primary)] font-bold">{step.number} // STAGE</span>
            <span class="text-[#5a5a6a] uppercase">PHASE</span>
          </div>
          <h3 class="text-xl font-sans font-bold text-[var(--color-ink)] uppercase">
            {step.title}
          </h3>
          <p class="text-sm sm:text-base text-[var(--color-body)] leading-relaxed font-sans font-light">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
