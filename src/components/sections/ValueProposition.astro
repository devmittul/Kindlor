---
import SectionHeader from '../ui/SectionHeader.astro';
import { WEBSITE_FUNCTIONS } from '../../data/homeData';
---

<section class="py-24 px-4 sm:px-8 lg:px-12 border-b border-[var(--color-hairline)] bg-[var(--color-surface-soft)]" id="value-proposition">
  <div class="max-w-[1280px] mx-auto space-y-16">
    <SectionHeader
      number="01"
      eyebrow="WHY IT MATTERS"
      title="PEOPLE SEARCH BEFORE THEY CHOOSE."
      description="Your digital presence must answer their questions immediately. A professional system gives your business a permanent digital home where those answers are clear, searchable, and available 24/7."
    />

    <div class="flex overflow-x-auto snap-x snap-mandatory pb-6 gap-6 md:grid md:grid-cols-2 lg:grid-cols-3 md:overflow-visible [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
      {WEBSITE_FUNCTIONS.map((card) => (
        <div class="snap-start shrink-0 w-[85vw] md:w-auto bg-[var(--color-surface-card)] p-8 rounded-xl border border-[var(--color-hairline)] flex flex-col justify-between hover:border-[var(--color-hairline-strong)] transition-all group">
          <div>
            <div class="flex items-center justify-between text-[12px] font-mono text-[var(--color-muted)] mb-4">
              <span class="text-[var(--color-primary)] font-bold">{card.number}</span>
              <span class="uppercase tracking-widest text-[10px]">FUNCTION</span>
            </div>
            <h3 class="text-xl font-sans font-bold text-[var(--color-ink)] mb-3 group-hover:text-[var(--color-primary-active)] transition-colors">
              {card.title}
            </h3>
            <p class="text-[14px] sm:text-[16px] text-[var(--color-body)] leading-relaxed font-sans">
              {card.description}
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-[var(--color-hairline)] text-[10px] font-mono text-[var(--color-muted-soft)] uppercase tracking-wider">
            SYSTEM ENGINE // ACTIVE
          </div>
        </div>
      ))}
      
      <!-- System Thinking Card (merged from WhyKindlor) -->
      <div class="snap-start shrink-0 w-[85vw] md:w-auto bg-[var(--color-surface-card)] p-8 rounded-xl border border-[var(--color-hairline)] flex flex-col justify-between hover:border-[var(--color-hairline-strong)] transition-all group">
        <div>
          <div class="flex items-center justify-between text-[12px] font-mono text-[var(--color-muted)] mb-4">
            <span class="text-[var(--color-primary)] font-bold">06</span>
            <span class="uppercase tracking-widest text-[10px]">INTEGRATION</span>
          </div>
          <h3 class="text-xl font-sans font-bold text-[var(--color-ink)] mb-3 group-hover:text-[var(--color-primary-active)] transition-colors">
            System Thinking
          </h3>
          <p class="text-[14px] sm:text-[16px] text-[var(--color-body)] leading-relaxed font-sans">
            We don't stop at the homepage. When useful, the website becomes the entry point to booking, enquiries, customer workflows, and business operations.
          </p>
        </div>
        <div class="mt-8 pt-4 border-t border-[var(--color-hairline)] text-[10px] font-mono text-[var(--color-muted-soft)] uppercase tracking-wider">
          BUSINESS WORKFLOWS // ACTIVE
        </div>
      </div>
    </div>
  </div>
</section>
