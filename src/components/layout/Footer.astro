---
---
<footer class="bg-[var(--color-canvas)] text-[var(--color-muted)] py-16 px-4 sm:px-8 lg:px-12 border-t border-[var(--color-hairline)]" data-purpose="site-footer">
  <div class="max-w-[1280px] mx-auto">
    <!-- Brand Wordmark -->
    <div class="mb-12">
      <span class="font-sans font-bold text-xl tracking-tight text-[var(--color-ink)]">KINDLOR</span>
    </div>

    <!-- Link Columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-16 text-[14px]">
      <div>
        <h4 class="font-semibold text-[var(--color-ink)] mb-4">Product</h4>
        <ul class="space-y-3">
          <li><a href="/services" class="hover:text-[var(--color-ink)] transition-colors">Websites</a></li>
          <li><a href="/services" class="hover:text-[var(--color-ink)] transition-colors">Booking Systems</a></li>
          <li><a href="/services" class="hover:text-[var(--color-ink)] transition-colors">WhatsApp Automations</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-[var(--color-ink)] mb-4">Use Cases</h4>
        <ul class="space-y-3">
          <li><a href="/work" class="hover:text-[var(--color-ink)] transition-colors">Restaurants</a></li>
          <li><a href="/work" class="hover:text-[var(--color-ink)] transition-colors">Agencies</a></li>
          <li><a href="/work" class="hover:text-[var(--color-ink)] transition-colors">Professional Services</a></li>
          <li><a href="/work" class="hover:text-[var(--color-ink)] transition-colors">E-Commerce</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-[var(--color-ink)] mb-4">Contact Info</h4>
        <ul class="space-y-3">
          <li>
            <a href="mailto:hello@kindlor.com" class="hover:text-[var(--color-ink)] transition-colors flex items-center space-x-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              <span>hello@kindlor.com</span>
            </a>
          </li>
          <li>
            <a href="tel:+919468788874" class="hover:text-[var(--color-ink)] transition-colors flex items-center space-x-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              <span>+91 9468788874</span>
            </a>
          </li>
          <li>
            <a href="https://wa.me/919468788874" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-ink)] transition-colors flex items-center space-x-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
