        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-[var(--color-ink)] mb-4">Company</h4>
        <ul class="space-y-3">
          <li><a href="/about" class="hover:text-[var(--color-ink)] transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-[var(--color-ink)] transition-colors">Contact</a></li>
        </ul>
