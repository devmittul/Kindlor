    <!-- Copyright -->
    <div class="pt-8 border-t border-[var(--color-hairline)] flex flex-col sm:flex-row items-center justify-between text-[13px] text-[var(--color-muted-soft)] gap-4">
      <span>© 2026 KINDLOR STUDIO INC. ALL RIGHTS RESERVED.</span>
      <div class="flex space-x-6">
        <a class="hover:text-[var(--color-ink)] transition-colors" href="/privacy">Privacy Policy</a>
        <a class="hover:text-[var(--color-ink)] transition-colors" href="/terms">Terms of Service</a>
