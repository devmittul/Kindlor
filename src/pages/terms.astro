---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<BaseLayout
  title="Terms of Service | Kindlor Studio"
  description="Terms of Service for Kindlor Studio."
  currentPath="/terms"
>
  <div class="py-12 sm:py-24 px-4 sm:px-12 lg:px-24 max-w-4xl mx-auto space-y-12">
    <header class="border-b border-[var(--color-hairline)] pb-8 sm:pb-12">
      <SectionHeader
        eyebrow="LEGAL"
        title="TERMS OF SERVICE"
        description="Last updated: 2026. These terms govern your use of the Kindlor Studio website and services."
      />
    </header>

    <div class="prose prose-invert prose-p:text-[var(--color-body)] prose-headings:text-[var(--color-ink)] max-w-none font-sans font-light leading-relaxed space-y-6">
      <h3 class="text-xl font-bold text-[var(--color-ink)]">1. Acceptance of Terms</h3>
      <p class="text-[var(--color-body)]">By accessing or using our website and services, you agree to be bound by these Terms.</p>
      
      <h3 class="text-xl font-bold text-[var(--color-ink)]">2. Services Provided</h3>
      <p class="text-[var(--color-body)]">Kindlor provides high-end business websites, WhatsApp contact/lead flows, online booking systems, and custom digital workflows.</p>

      <h3 class="text-xl font-bold text-[var(--color-ink)]">3. Governing Law</h3>
      <p class="text-[var(--color-body)]">These terms shall be governed by and construed in accordance with the laws of India.</p>

      <h3 class="text-xl font-bold text-[var(--color-ink)]">4. Contact Us</h3>
      <p class="text-[var(--color-body)]">For any inquiries regarding these terms, please contact us at <a href="mailto:hello@kindlor.com" class="text-[var(--color-primary)] hover:underline">hello@kindlor.com</a> or via WhatsApp at <a href="https://wa.me/919468788874" class="text-[var(--color-primary)] hover:underline">+91 9468788874</a>.</p>
    </div>
  </div>
</BaseLayout>
