---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<BaseLayout
  title="Privacy Policy | Kindlor Studio"
  description="Privacy Policy for Kindlor Studio."
  currentPath="/privacy"
>
  <div class="py-12 sm:py-24 px-4 sm:px-12 lg:px-24 max-w-4xl mx-auto space-y-12">
    <header class="border-b border-[var(--color-hairline)] pb-8 sm:pb-12">
      <SectionHeader
        eyebrow="LEGAL"
        title="PRIVACY POLICY"
        description="Last updated: 2026. This Privacy Policy describes how Kindlor Studio collects, uses, and shares your personal information."
      />
    </header>

    <div class="prose prose-invert prose-p:text-[var(--color-body)] prose-headings:text-[var(--color-ink)] max-w-none font-sans font-light leading-relaxed space-y-6">
      <h3 class="text-xl font-bold text-[var(--color-ink)]">1. Information We Collect</h3>
      <p class="text-[var(--color-body)]">We collect information you provide directly to us when you request information, use our contact forms, or communicate with us via WhatsApp.</p>
      
      <h3 class="text-xl font-bold text-[var(--color-ink)]">2. How We Use Information</h3>
      <p class="text-[var(--color-body)]">We use the information we collect to provide, maintain, and improve our services, as well as to communicate directly with you regarding your projects.</p>

      <h3 class="text-xl font-bold text-[var(--color-ink)]">3. Contact Us</h3>
      <p class="text-[var(--color-body)]">If you have any questions about this Privacy Policy, please contact us at <a href="mailto:hello@kindlor.com" class="text-[var(--color-primary)] hover:underline">hello@kindlor.com</a> or via WhatsApp at <a href="https://wa.me/919468788874" class="text-[var(--color-primary)] hover:underline">+91 9468788874</a>.</p>
    </div>
  </div>
</BaseLayout>
